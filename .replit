modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bake-Off Run"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bake-Off Judge Panel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Claude Code Factory Audit"

[[workflows.workflow]]
name = "Bake-Off Run"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BAKEOFF_TARGET_URL='https://www.stselectronicrecyclinginc.com/bakersfield-ca' BAKEOFF_CITY='Bakersfield' BAKEOFF_STATE='CA' BAKEOFF_NICHE='electronics recycling' BAKEOFF_PAGE_TYPE='SPOKE' BAKEOFF_CLASSIFICATION='NEW_BUILD' BAKEOFF_COMPETITION='MEDIUM' BAKEOFF_SCENARIOS='no-gmb' BAKEOFF_GROUNDING_PROVIDER='google' BAKEOFF_GROUNDING_MODEL='gemini-3.7-flash' BAKEOFF_FORCE='grok-4-6,grok-4-20-reasoning,gemini-3-1-pro-low,gemini-3-1-pro-medium,gemini-3-7-flash-low,gemini-3-7-flash-medium,gpt-luna-medium,gpt-luna-high,gpt-terra,deepseek-v4-flash,deepseek-v4-pro' BAKEOFF_MAX_ATTEMPTS='1' BAKEOFF_REQUEST_TIMEOUT_MS='1500000' BAKEOFF_GROK_FIRST_EVENT_TIMEOUT_MS='420000' BAKEOFF_GROK_STREAM_IDLE_TIMEOUT_MS='420000' BAKEOFF_GROK_SEARCH_FIRST_EVENT_TIMEOUT_MS='420000' BAKEOFF_GROK_SEARCH_IDLE_TIMEOUT_MS='420000' BAKEOFF_VARIANTS='[{\"baseId\":\"grok\",\"id\":\"grok-4-6\",\"model\":\"grok-4.6\",\"label\":\"Grok 4.6\"},{\"baseId\":\"grok\",\"id\":\"grok-4-20-reasoning\",\"model\":\"grok-4.20-0309-reasoning\",\"label\":\"Grok 4.20 Reasoning\"},{\"baseId\":\"gemini\",\"id\":\"gemini-3-1-pro-low\",\"model\":\"gemini-3.1-pro-preview\",\"label\":\"Gemini 3.1 Pro\",\"effort\":\"low\"},{\"baseId\":\"gemini\",\"id\":\"gemini-3-1-pro-medium\",\"model\":\"gemini-3.1-pro-preview\",\"label\":\"Gemini 3.1 Pro\",\"effort\":\"medium\"},{\"baseId\":\"gemini-flash\",\"id\":\"gemini-3-7-flash-low\",\"model\":\"gemini-3.7-flash\",\"label\":\"Gemini 3.7 Flash\",\"effort\":\"low\"},{\"baseId\":\"gemini-flash\",\"id\":\"gemini-3-7-flash-medium\",\"model\":\"gemini-3.7-flash\",\"label\":\"Gemini 3.7 Flash\",\"effort\":\"medium\"},{\"baseId\":\"openai\",\"id\":\"gpt-luna-medium\",\"model\":\"gpt-5.6-luna\",\"label\":\"GPT-5.6 Luna\",\"effort\":\"medium\"},{\"baseId\":\"openai\",\"id\":\"gpt-luna-high\",\"model\":\"gpt-5.6-luna\",\"label\":\"GPT-5.6 Luna\",\"effort\":\"high\"},{\"baseId\":\"openai\",\"id\":\"gpt-terra\",\"model\":\"gpt-5.6-terra\",\"label\":\"GPT-5.6 Terra\"},{\"baseId\":\"deepseek-flash\",\"id\":\"deepseek-v4-flash\",\"model\":\"deepseek-v4-flash\",\"label\":\"DeepSeek v4 Flash\"},{\"baseId\":\"deepseek\",\"id\":\"deepseek-v4-pro\",\"model\":\"deepseek-v4-pro\",\"label\":\"DeepSeek v4 Pro\"}]' pnpm --filter @workspace/scripts run bakeoff"

[[workflows.workflow]]
name = "Bake-Off Judge Panel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run bakeoff:judge"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Claude Code Factory Audit"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "timeout 900s claude --model opus --effort high --permission-mode dontAsk --allowed-tools Read Glob Grep \"Bash(git status)\" -p \"$(cat .claude/factory-audit-prompt.md)\" --output-format text | tee .claude/factory-audit-report.md"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0", "google-drive:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 19951
externalPort = 3000

[[ports]]
localPort = 23464
externalPort = 3002

[[ports]]
localPort = 26054
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GITHUB_SOURCE_REPO = "xkluziv12/master-prompts"
