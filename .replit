modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bake-Off Run"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bake-Off Judge Panel"

[[workflows.workflow]]
name = "Bake-Off Run"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BAKEOFF_TARGET_URL='https://www.stselectronicrecyclinginc.com/bakersfield-ca' BAKEOFF_CITY='Bakersfield' BAKEOFF_STATE='CA' BAKEOFF_NICHE='electronics recycling' BAKEOFF_PAGE_TYPE='SPOKE' BAKEOFF_CLASSIFICATION='NEW_BUILD' BAKEOFF_COMPETITION='MEDIUM' BAKEOFF_SCENARIOS='no-gmb' BAKEOFF_GROUNDING_PROVIDER='google' BAKEOFF_GROUNDING_MODEL='gemini-3.7-flash' BAKEOFF_FORCE='grok-4-6' BAKEOFF_MAX_ATTEMPTS='1' BAKEOFF_REQUEST_TIMEOUT_MS='1500000' BAKEOFF_GROK_FIRST_EVENT_TIMEOUT_MS='420000' BAKEOFF_GROK_STREAM_IDLE_TIMEOUT_MS='420000' BAKEOFF_GROK_SEARCH_FIRST_EVENT_TIMEOUT_MS='420000' BAKEOFF_GROK_SEARCH_IDLE_TIMEOUT_MS='420000' BAKEOFF_VARIANTS='[{\"baseId\":\"grok\",\"id\":\"grok-4-6\",\"model\":\"grok-4.6\",\"label\":\"Grok 4.6\"}]' pnpm --filter @workspace/scripts run bakeoff"

[[workflows.workflow]]
name = "Bake-Off Judge Panel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run bakeoff:judge"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0", "google-drive:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 19951
externalPort = 3000

[[ports]]
localPort = 23464
externalPort = 3002

[[ports]]
localPort = 26054
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GITHUB_SOURCE_REPO = "xkluziv12/master-prompts"
